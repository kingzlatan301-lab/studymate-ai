{
  "functions": {
    "api/ask.js": {
      "maxDuration": 30
    },
    "api/youtube.js": {
      "maxDuration": 15
    },
    "api/usage.js": {
      "maxDuration": 10
    },
    "api/verify-payment.js": {
      "maxDuration": 20
    },
    "api/paystack-webhook.js": {
      "maxDuration": 20
    },
    "api/analyze-paper.js": {
      "maxDuration": 45
    },
    "api/checkout.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
