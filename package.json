{
  "name": "studymate-ai",
  "version": "1.0.0",
  "description": "StudyMate AI — global AI-powered exam prep for students worldwide",
  "scripts": {
    "serve": "npx serve . -l 5173",
    "sync": "npm run build:web && cap sync",
    "android": "npm run build:web && cap sync android && cap run android",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "test": "node --test tests/regression-contracts.test.js",
    "build:web": "node scripts/build-web.js",
    "test:e2e": "node --test tests/e2e/preview-smoke.e2e.test.js",
    "syllabus:import": "node scripts/import-syllabus.js",
    "syllabus:check": "node scripts/import-syllabus.js --check",
    "syllabus:publish": "node scripts/publish-syllabus.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
